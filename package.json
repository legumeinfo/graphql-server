{
  "name": "@legumeinfo/graphql-server",
  "version": "1.8.0",
  "author": "Legume Information System",
  "main": "dist/index.js",
  "dependencies": {
    "@apollo/datasource-rest": "^6.4.1",
    "@apollo/server": "^4.12.0",
    "@eslint/js": "^9.26.0",
    "@graphql-tools/load-files": "^7.0.1",
    "@graphql-tools/merge": "^9.0.24",
    "@types/eslint__js": "^9.14.0",
    "dotenv": "^16.5.0",
    "eslint": "^9.26.0",
    "eslint-config-prettier": "^10.1.2",
    "graphql": "^16.11.0",
    "husky": "^9.1.7",
    "lint-staged": "^15.5.1",
    "prettier": "^3.5.3",
    "tsc-watch": "^6.2.1",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.32.0"
  },
  "description": "A GraphQL server that supports the Legume Information System and related biodata websites",
  "keywords": [
    "typescript",
    "graphql",
    "apollo",
    "legumes",
    "agbio",
    "biology"
  ],
  "license": "Apache-2.0",
  "scripts": {
    "build": "tsc && cp ./src/types/*.graphql ./dist/types",
    "build:watch": "tsc-watch",
    "clean": "rm -rf ./dist",
    "lint": "bun run lint:eslint",
    "lint:eslint": "eslint \"src/*.ts\" \"src/**/*.ts\"",
    "lint:eslint-config-prettier": "eslint-config-prettier \"src/*.ts\" \"src/**/*.ts\"",
    "format": "prettier \"src/*.ts\" \"src/**/*.ts\" --write",
    "serve": "bun run build && bun run ./dist/index.js",
    "serve:dev": "NODE_ENV=development bun run tsc-watch --onSuccess \"bun run serve\"",
    "serve:prod": "NODE_ENV=production bun run serve",
    "start": "bun run clean && bun run build && bun run serve",
    "postinstall": "husky",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:watch": "vitest --watch",
    "test:coverage": "vitest --coverage",
    "test:integration:real": "TEST_WITH_REAL_ENDPOINTS=true vitest run tests/integration/real",
    "test:performance": "TEST_WITH_REAL_ENDPOINTS=true vitest run tests/performance",
    "test:schema-coverage": "TEST_WITH_REAL_ENDPOINTS=true vitest run tests/integration/real/comprehensive-schema-coverage.test.ts",
    "test:data-validation": "TEST_WITH_REAL_ENDPOINTS=true vitest run tests/integration/real/data-validation-schema-compliance.test.ts",
    "test:all-real": "TEST_WITH_REAL_ENDPOINTS=true vitest run tests/integration/real tests/performance",
    "test:ci": "vitest run --coverage --reporter=junit --outputFile=test-results.xml"
  },
  "type": "module",
  "devDependencies": {
    "@faker-js/faker": "^10.0.0",
    "@graphql-tools/schema": "^10.0.25",
    "@types/node": "^24.3.0",
    "@vitest/ui": "^3.2.4",
    "c8": "^10.1.3",
    "graphql-request": "^7.2.0",
    "vitest": "^3.2.4"
  }
}
