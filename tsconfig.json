{
  // `include` scopes the build to src. Without it tsc compiles every .ts under the
  // project, which makes it infer a common root of "." as soon as a sibling dir
  // (e.g. test/) has one — emitting dist/src/… instead of dist/… and breaking both
  // `main` and the .graphql copy step. `rootDir` pins that layout regardless.
  "include": ["src"],
  "compilerOptions": {
    "rootDir": "src",
    "rootDirs": ["src"],
    "outDir": "dist",
    "lib": ["es2020"],
    "target": "es2020",
    "module": "esnext",
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "noImplicitAny": true,
    "moduleResolution": "node",
    "esModuleInterop": true,
    "noImplicitOverride": true,
    "types": ["node", "bun"]
  }
}
